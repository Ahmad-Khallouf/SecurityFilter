{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Upload": {
    "MaxFileSizeBytes": 5242880,
    "StorageRoot": "uploads",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".svg", ".pdf" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/svg+xml", "application/pdf" ]
  },
  "Yara": {
    "ExecutablePath": "C:/yara/yara64.exe",
    "RulesFilePath": "YaraRules/rules.yar",
    "TimeoutMs": 10000
  },
  "PdfDecode": {
    "MaxBytesPerStream": 10485760,
    "MaxTotalBytes": 52428800,
    "MaxExpansionRatio": 1500,
    "MaxDecodeDepth": 4
  },
  "ReEncoding": {
    "MaxWidth": 10000,
    "MaxHeight": 10000,
    "MaxTotalPixels": 40000000,
    "JpegQuality": 90,
    "StripMetadata": true,
    "ClearLeastSignificantBit": true,
    "MagickMemoryLimitMb": 256
  },
  "Demo": {
    "Enabled": true,
    "ComparisonStorageRoot": "comparison-output",
    "CorpusRoot": "C:/Users/ellio/Desktop/senior 2/samples/corpus_full_test"
  },
  "Cache": {
    "Enabled": true,
    "MaxEntries": 10000,
    "TtlMinutes": 60
  }
}